{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "module": "commonjs",
    "target": "es2020",
    "outDir": "dist",
    "types": ["node", "mocha", "chai"]
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
